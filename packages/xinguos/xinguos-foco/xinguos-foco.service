[Unit]
Description=XInguOS Foco: prioridade do app em foco e tempo de uso
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/xinguos-foco
Restart=on-failure
RestartSec=5
# 3 = já tem outro xinguos-foco nesta sessão: reiniciar não adianta
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
