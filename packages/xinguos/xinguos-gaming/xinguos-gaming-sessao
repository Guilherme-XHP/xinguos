#!/usr/bin/env bash
# xinguos-gaming-sessao — a sessão "XInguOS Gaming" do SDDM (spec 4.1 e 4.4).
#   completo:   gamescope-session-plus steam (gamescope embutido + Steam + mangoapp)
#   compatível: KWin sozinho + Steam em tela cheia (sem painéis; para GPUs onde o
#               gamescope dá tela preta, como as GTX 10xx no driver 580xx)
# Como a sessão termina:
#   - troca pedida (marca troca-pedida do xinguos-session-select): segue para onde foi pedido;
#   - durou menos de 60 s sem troca pedida: QUEDA (o código de saída não serve: o
#     gamescope-session-plus sempre sai 0). Com 2 quedas seguidas, o próximo login vai para
#     a Área de Trabalho e fica um aviso. Nunca existe loop (spec 4.4);
#   - sessão longa sem troca pedida (o usuário saiu do Steam): vai para a Área de Trabalho.
set -uo pipefail

ETC=${XINGUOS_ETC:-/etc/xinguos}
ESTADO=${XINGUOS_ESTADO:-${XDG_STATE_HOME:-$HOME/.local/state}/xinguos}
LIMITE_RAPIDA=60
MAX_FALHAS=2

mkdir -p "$ESTADO"
rm -f "$ESTADO/troca-pedida"
modo=$(sed -n 's/^MODO_GAMING=//p' "$ETC/gaming.conf" 2>/dev/null | tail -1)
inicio=$(date +%s)
case "$modo" in
  completo) gamescope-session-plus steam ;;
  *) kwin_wayland --xwayland --exit-with-session /usr/lib/xinguos/xinguos-steam-compativel ;;
esac
rc=$?
duracao=$(( $(date +%s) - inicio ))

contador="$ESTADO/gaming-falhas"
if [ -e "$ESTADO/troca-pedida" ]; then
  rm -f "$ESTADO/troca-pedida"
  echo 0 > "$contador"
elif [ "$duracao" -lt "$LIMITE_RAPIDA" ]; then
  anterior=$(cat "$contador" 2>/dev/null || true)
  [[ "$anterior" =~ ^[0-9]+$ ]] || anterior=0
  falhas=$((anterior + 1))
  if [ "$falhas" -ge "$MAX_FALHAS" ]; then
    echo 0 > "$contador"
    : > "$ESTADO/gaming-aviso"
    echo "xinguos-gaming-sessao: o Gaming Mode caiu $falhas vezes seguidas; indo para a Área de Trabalho" >&2
    xinguos-session-select --proxima desktop || true
  else
    echo "$falhas" > "$contador"
  fi
else
  echo 0 > "$contador"
  xinguos-session-select --proxima desktop || true
fi
exit "$rc"
