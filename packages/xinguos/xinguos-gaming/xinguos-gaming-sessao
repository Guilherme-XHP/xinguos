#!/usr/bin/env bash
# xinguos-gaming-sessao — a sessão "XInguOS Gaming" do SDDM (spec 4.1 e 4.4).
#   completo:   gamescope-session-plus steam (gamescope embutido + Steam + mangoapp)
#   compatível: KWin sozinho + Steam em tela cheia (sem painéis; para GPUs onde o
#               gamescope dá tela preta, como as GTX 10xx no driver 580xx)
# Como a sessão termina:
#   - troca pedida (marca troca-pedida do xinguos-session-select): segue para onde foi pedido;
#   - durou menos de 60 s sem troca pedida: QUEDA (o código de saída não serve: o
#     gamescope-session-plus sempre sai 0). Com 2 quedas seguidas, o próximo login vai para
#     a Área de Trabalho e fica um aviso. Nunca existe loop (spec 4.4);
#   - sessão longa sem troca pedida (o usuário saiu do Steam): vai para a Área de Trabalho.
set -uo pipefail

ETC=${XINGUOS_ETC:-/etc/xinguos}
ESTADO=${XINGUOS_ESTADO:-${XDG_STATE_HOME:-$HOME/.local/state}/xinguos}
LIMITE_RAPIDA=60
MAX_FALHAS=2
LOG_SESSAO="$ESTADO/gaming-sessao.log"

# registro curto de cada sessão (o xinguos-teste junta tudo); também vai para o
# stderr, que o SDDM guarda em ~/.local/share/sddm/wayland-session.log
registrar() {
  local linha
  printf -v linha '%(%F %T)T %s' -1 "$*"
  echo "xinguos-gaming-sessao: $*" >&2
  echo "$linha" >> "$LOG_SESSAO" 2>/dev/null || return 0
  if [ "$(wc -l < "$LOG_SESSAO")" -gt 500 ]; then
    tail -n 300 "$LOG_SESSAO" > "$LOG_SESSAO.tmp" && mv -f "$LOG_SESSAO.tmp" "$LOG_SESSAO"
  fi
}

mkdir -p "$ESTADO"
rm -f "$ESTADO/troca-pedida"
modo=$(sed -n 's/^MODO_GAMING=//p' "$ETC/gaming.conf" 2>/dev/null | tail -1)
[ "$modo" = completo ] || modo=compativel
registrar "inicio modo=$modo usuario=$(id -un 2>/dev/null) XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-}"
# sessão encerrada de fora (logout, SDDM): o bash só roda o trap quando o filho termina,
# e aí o fim da sessão segue normal (conta queda, grava o log)
for s in TERM HUP INT; do
  # shellcheck disable=SC2064
  trap "registrar 'sinal $s recebido (sessão encerrada de fora)'" "$s"
done
# o KWin/gamescope e o Steam escrevem aqui (só a última sessão; antes ia só para o log do SDDM)
SAIDA="$ESTADO/gaming-ultima-sessao.log"
printf -v agora '%(%F %T)T' -1
echo "== sessão Gaming $agora modo=$modo" > "$SAIDA" 2>/dev/null || SAIDA=/dev/null
inicio=$(date +%s)
case "$modo" in
  completo) gamescope-session-plus steam >> "$SAIDA" 2>&1 ;;
  *) kwin_wayland --xwayland --exit-with-session /usr/lib/xinguos/xinguos-steam-compativel >> "$SAIDA" 2>&1 ;;
esac
rc=$?
duracao=$(( $(date +%s) - inicio ))

contador="$ESTADO/gaming-falhas"
if [ -e "$ESTADO/troca-pedida" ]; then
  rm -f "$ESTADO/troca-pedida"
  echo 0 > "$contador"
  registrar "fim rc=$rc duracao=${duracao}s resultado=troca-pedida"
elif [ "$duracao" -lt "$LIMITE_RAPIDA" ]; then
  anterior=$(cat "$contador" 2>/dev/null || true)
  [[ "$anterior" =~ ^[0-9]+$ ]] || anterior=0
  falhas=$((anterior + 1))
  registrar "fim rc=$rc duracao=${duracao}s resultado=queda falhas=$falhas"
  if [ "$falhas" -ge "$MAX_FALHAS" ]; then
    echo 0 > "$contador"
    : > "$ESTADO/gaming-aviso"
    echo "xinguos-gaming-sessao: o Gaming Mode caiu $falhas vezes seguidas; indo para a Área de Trabalho" >&2
    xinguos-session-select --proxima desktop || true
  else
    echo "$falhas" > "$contador"
  fi
else
  echo 0 > "$contador"
  registrar "fim rc=$rc duracao=${duracao}s resultado=saiu-do-steam"
  xinguos-session-select --proxima desktop || true
fi
exit "$rc"
